# Copy to /opt/patrn.ink/.env on the EC2 host. Never commit the real file.
#   cp env.prod.example .env

# --- AWS / images ---
AWS_REGION=us-east-1
ECR_REGISTRY=032761628241.dkr.ecr.us-east-1.amazonaws.com
ECR_API_REPOSITORY=patrn-ink-api
ECR_UI_REPOSITORY=patrn-ink-ui
API_IMAGE_TAG=replace-with-sha-or-version
UI_IMAGE_TAG=replace-with-sha-or-version

# --- Secrets (never commit real values) ---
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redis Cloud (redis.io). This is the database password, not the Redis Cloud account API key.
REDIS_ADDR=redis-19005.c330.asia-south1-1.gce.cloud.redislabs.com:19005
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-redis-cloud-password

# --- Optional ---
JWT_EXPIRATION_HOURS=168
DEFAULT_RATE_LIMIT=60
API_TOKEN_RATE_LIMIT=100
CERTBOT_EMAIL=you@example.com

# Production URLs are hard-wired in docker-compose.prod.yml:
#   ENVIRONMENT=production
#   BASE_URL=https://api.patrn.ink
#   FRONTEND_URL=https://patrn.ink
#   ALLOWED_ORIGINS=https://patrn.ink
#   GOOGLE_REDIRECT_URL=https://api.patrn.ink/auth/google/callback
#   GITHUB_REDIRECT_URL=https://api.patrn.ink/auth/github/callback
#
# Do not set DYNAMODB_ENDPOINT. Production uses Amazon DynamoDB via the
# EC2 instance role. Do not put AWS access keys in this file.
# Do not run Redis or DynamoDB Local on the EC2 host.
